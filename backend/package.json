{
  "name": "veloztix-backend",
  "version": "1.0.0",
  "description": "VelozTix Core - Backend Merchant & Ticketing Mediator API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/backend.spec.ts tests/certification.test.ts",
    "test:cert": "tsx --test tests/certification.test.ts",
    "benchmark": "tsx scripts/kpi_benchmark.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
